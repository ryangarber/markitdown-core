{
	"name": "markitdown-core",
	"version": "0.2.3",
	"description": "Convert various file formats to Markdown for indexing, text analysis, and other applications that benefit from structured text. Node-free fork of the TypeScript fork of the original Python library.",
	"keywords": [
		"markdown",
		"converter",
		"browser",
		"uint8array",
		"docx",
		"pdf",
		"xlsx",
		"pptx",
		"zip"
	],
	"homepage": "https://github.com/ryangarber/markitdown-core#readme",
	"bugs": {
		"url": "https://github.com/ryangarber/markitdown-core/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ryangarber/markitdown-core.git"
	},
	"license": "MIT",
	"author": "Ryan Garber",
	"contributors": [
		"Vaibhav Raj"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"cli": "node ./src/cli.ts",
		"build": "tsdown && pnpm man",
		"build:cli": "node ./scripts/build-cli.ts",
		"lint": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest",
		"man": "node ./scripts/build-man.ts"
	},
	"bin": {
		"markitdown": "./dist/cli.mjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@jvmr/pptx-to-html": "^1.1.2",
		"@optique/core": "^1.3.6",
		"@optique/man": "^1.3.6",
		"@optique/run": "^1.3.6",
		"@truto/turndown-plugin-gfm": "^1.0.7",
		"@xmldom/xmldom": "^0.9.12",
		"fflate": "^0.8.3",
		"file-type": "^22.3.0",
		"linkedom": "0.18.15",
		"mammoth": "^1.13.0",
		"mime": "^4.1.2",
		"read-excel-file": "^9.3.17",
		"turndown": "^7.2.5",
		"unpdf": "^2.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.7",
		"@ryangarber/utils": "^0.1.6",
		"@types/node": "^26.6.6",
		"@types/turndown": "^5.0.6",
		"knip": "^6.45.1",
		"tsdown": "^0.23.7",
		"typescript": "7.1.0-beta",
		"vitest": "^5.1.0"
	},
	"packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
	"devEngines": {
		"runtime": [
			{
				"name": "node",
				"version": ">=24 <27",
				"onFail": "download"
			},
			{
				"name": "bun",
				"version": ">=1.4 <2",
				"onFail": "download"
			}
		]
	},
	"man": "./dist/markitdown.1"
}
